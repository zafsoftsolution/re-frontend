# Copy to .env.local for local dev. Never commit real values (repo is public).

# ── Build-time (inlined into the browser bundle) ─────────────────────────────
# In CI these come from GitHub Actions *variables* (vars.*) as Docker build args.
NEXT_PUBLIC_DJANGO_API_URL=
NEXT_PUBLIC_DJANGO_BACKEND=

# ── Server-only runtime (put in ~/RE/re_frontend/.env.local on the server) ─────────
# Legacy: only the removed in-memory mock API used this. Safe to drop from
# the server env once the rebuild is live.
JMN_JWT_SECRET=
# Backend URL used by server-side rendering (defaults to http://backend:9086
# over the shared Docker network in docker-compose.prod.yml).
INTERNAL_DJANGO_BACKEND=
# Shared secret for POST /api/revalidate (header `x-revalidate-secret`). The
# Django backend sends it with {"tags": [...]} after catalogue/settings
# changes. Use a long random string; leave empty to disable the endpoint.
REVALIDATE_SECRET=
# Server-only. Sent as `X-Internal-Secret` on every SSR/RSC request to Django
# so the site isn't throttled as one anonymous visitor. Must match the
# backend's INTERNAL_API_SECRET. NEVER prefix with NEXT_PUBLIC_.
INTERNAL_API_SECRET=

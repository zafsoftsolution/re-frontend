# Copy to .env.local for local dev. Never commit real values (repo is public).

# ── Build-time (inlined into the browser bundle) ─────────────────────────────
# In CI these come from GitHub Actions *variables* (vars.*) as Docker build args.
NEXT_PUBLIC_DJANGO_API_URL=
NEXT_PUBLIC_DJANGO_BACKEND=

# ── Server-only runtime (put in ~/RE/re_frontend/.env.local on the server) ─────────
# Secret used to sign/verify admin JWTs. REQUIRED in production.
JMN_JWT_SECRET=
# Backend URL used by server-side rendering (defaults to http://backend:9086
# over the shared Docker network in docker-compose.prod.yml).
INTERNAL_DJANGO_BACKEND=
